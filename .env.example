# ─────────────────────────────────────────────────────────────────────────────
# GAIA VAULT — Environment configuration
#
# Copy this file to `.env.local` for local development and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.
# All secrets live in env, never in code (see /docs/SECURITY.md).
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Gaia Vault"

# ── Data residency ───────────────────────────────────────────────────────────
# RESIDENCY: v1 ships a single AU region. The region is config, not code, so
# additional regions (UK/EU/US) can be added without refactor. See
# /docs/DATA-RESIDENCY.md. Must be one of: au | uk | eu | us
NEXT_PUBLIC_REGION=au

# ── Supabase ─────────────────────────────────────────────────────────────────
# The publishable (anon) key is safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# The service-role key bypasses RLS. SERVER ONLY. Never expose to the client.
# Used only by trusted server actions, Edge Functions, and the admin console.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Encryption (see /docs/SECURITY.md for the full threat model) ─────────────
# The release-set wrapping key. v1 holds this in env; PRODUCTION MUST move this
# to a KMS / Supabase Vault (see "production hardening TODO" in SECURITY.md).
# 32 bytes, base64-encoded. Generate with:  openssl rand -base64 32
RELEASE_WRAPPING_KEY=
# Server-side pepper mixed into per-user key derivation. 32 bytes base64.
VAULT_KEY_DERIVATION_PEPPER=

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID for the single paid plan (~A$99/yr). Free tier needs no price.
STRIPE_PRICE_ID_ANNUAL=price_...

# ── Email (Resend or equivalent — abstracted behind lib/email) ───────────────
RESEND_API_KEY=re_...
EMAIL_FROM="Gaia Vault <care@vault.gaiaapp.net>"

# ── Admin console ────────────────────────────────────────────────────────────
# Comma-separated list of admin email addresses permitted into the review queue.
# Admin access is additionally enforced at the database layer (see RLS).
ADMIN_ALLOWLIST=

# ── Feature flags — GATED capabilities (see /docs/LEGAL-GATES.md) ────────────
# LEGAL-GATE: financial credentials require GLBA + computer-misuse legal opinion.
FEATURE_CREDENTIALS=false
# LEGAL-GATE: cross-product data sharing needs consent + DPA review.
FEATURE_CRM_SYNC=false
# LEGAL-GATE: death-database signals are corroboration only, never a trigger.
FEATURE_DEATH_DB_CHECKS=false
